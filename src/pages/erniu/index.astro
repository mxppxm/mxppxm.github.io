---
import { ERNIU_ITEMS, ERNIU_HASH } from '../../data/erniu-gallery.mjs';

// 按章节分组，保持阅读顺序
const chapters = [];
const map = new Map();
for (const it of ERNIU_ITEMS) {
  if (!map.has(it.c)) { map.set(it.c, []); chapters.push(it.c); }
  map.get(it.c).push(it);
}
const chapterData = chapters.map((c, i) => ({
  id: c,
  title: map.get(c)[0].t || '',
  imgs: map.get(c),
  n: i + 1
}));
const hash = Number(ERNIU_HASH);
const total = chapters.length;
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title></title>
  <style is:inline>
    /* ═══ 九日 Blog — 纸墨质感 · 与博客文章同款设计语言 ═══ */
    :root {
      --accent: #07C160;
      --accent-dark: #048C48;
      --accent-light: #E8F8EE;
      --bg: #FCFAF7;
      --surface: #FFFFFF;
      --text: #1B1816;
      --text-secondary: #544F49;
      --text-muted: #8A8278;
      --ink: #3A342E;
      --border: #E6E0D6;
      --border-light: #F0EBE3;
      --border-strong: #D5CEC2;
      --shadow-xs: 0 1px 2px rgba(0,0,0,0.04);
      --shadow-sm: 0 1px 3px rgba(0,0,0,0.05), 0 4px 8px rgba(0,0,0,0.03);
      --shadow-md: 0 2px 8px rgba(0,0,0,0.06), 0 8px 20px rgba(0,0,0,0.04);
      --shadow-lg: 0 4px 16px rgba(0,0,0,0.07), 0 16px 40px rgba(0,0,0,0.05);
      --radius-sm: 6px;
      --radius: 10px;
      --radius-lg: 16px;
      --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
    }
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Noto Sans SC", sans-serif;
      background:
        radial-gradient(ellipse 50% 25% at 50% 0%, rgba(0,0,0,0.015) 0%, transparent 60%),
        var(--bg);
      color: var(--text);
      line-height: 1.75;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      min-height: 100vh;
      position: relative;
    }

    /* ── 顶部章节导航（sticky，毛玻璃） ── */
    #nav {
      display: none;
      position: sticky; top: 0; z-index: 100;
      background: rgba(252,250,247,0.88);
      backdrop-filter: blur(16px) saturate(160%);
      -webkit-backdrop-filter: blur(16px) saturate(160%);
      border-bottom: 1px solid var(--border-light);
    }
    #nav .nav-inner {
      max-width: 820px; margin: 0 auto;
      display: flex; align-items: center; gap: 6px;
      padding: 10px 18px;
      overflow-x: auto; scrollbar-width: none;
    }
    #nav .nav-inner::-webkit-scrollbar { display: none; }
    #nav .brand {
      font-weight: 750; font-size: 15px; color: var(--text);
      text-decoration: none; white-space: nowrap;
      margin-right: 10px; letter-spacing: -0.3px;
      display: inline-flex; align-items: center; gap: 6px;
      cursor: pointer;
    }
    #nav .brand em { font-style: normal; color: var(--accent); }
    #nav a.chip, #nav .chip {
      flex: 0 0 auto; text-decoration: none;
      color: var(--text-secondary); font-size: 12.5px; font-weight: 520;
      padding: 6px 13px; border-radius: 999px;
      background: var(--surface);
      border: 1px solid var(--border-light);
      transition: all 0.2s var(--ease-out);
      cursor: pointer; display: inline-block;
    }
    #nav a.chip:hover, #nav .chip:hover { color: var(--accent); border-color: rgba(7,193,96,0.4); background: var(--accent-light); }
    #nav a.chip.active, #nav .chip.active {
      color: var(--accent-dark);
      background: var(--accent-light);
      border-color: var(--accent);
      font-weight: 650;
    }

    /* ── 画廊主体（当前集） ── */
    #gallery { display: none; max-width: 820px; margin: 0 auto; padding: 0 0 8px; }

    /* 章节头 —— 编辑部章节开篇风格 */
    .sec-head {
      padding: 44px 20px 12px;
      margin-bottom: 20px;
    }
    .sec-head .kicker {
      display: inline-block; font-size: 12px; font-weight: 620;
      color: var(--accent-dark); background: var(--accent-light);
      padding: 3px 12px; border-radius: 8px;
      letter-spacing: 0.5px; margin-bottom: 10px;
    }
    .sec-head h2 {
      font-size: clamp(22px, 3.2vw, 28px);
      font-weight: 740; color: var(--text);
      letter-spacing: -0.5px; line-height: 1.3;
    }
    .sec-head .count {
      font-size: 13px; color: var(--text-muted);
      font-variant-numeric: tabular-nums;
      margin-top: 4px;
    }
    .sec-head .divider {
      height: 2px; background: var(--border);
      border: none; margin: 14px 0 0;
    }

    /* 分镜图 —— 白卡片 + 柔和阴影 */
    .frame { padding: 0 20px 14px; }
    .frame img {
      width: 100%; height: auto; display: block;
      border-radius: 12px;
      background: var(--surface);
      box-shadow: var(--shadow-md);
      transition: transform 0.25s var(--ease-out), box-shadow 0.25s var(--ease-out);
    }
    @media (hover: hover) {
      .frame img:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-lg);
      }
    }

    /* ── 上/下一集切换条 ── */
    .pager {
      display: flex; align-items: center; justify-content: space-between; gap: 10px;
      padding: 8px 20px 40px;
    }
    .pager button {
      flex: 1;
      display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1px;
      text-align: center; text-decoration: none;
      background: var(--surface);
      color: var(--accent-dark);
      border: 1.5px solid var(--border);
      border-radius: var(--radius);
      padding: 13px 16px;
      font-size: 14px; font-weight: 650;
      box-shadow: var(--shadow-xs);
      transition: all 0.25s var(--ease-out);
      cursor: pointer;
    }
    .pager button:hover:not(:disabled) {
      border-color: var(--accent);
      background: var(--accent-light);
      transform: translateY(-1px);
      box-shadow: 0 2px 12px rgba(7,193,96,0.18);
    }
    .pager button:disabled {
      opacity: 0.35; cursor: not-allowed;
    }
    .pager button .sub {
      font-size: 12px; font-weight: 400; color: var(--text-muted);
    }
    .pager button:hover:not(:disabled) .sub { color: var(--accent-dark); }
    .pager .final {
      color: var(--text);
      background: linear-gradient(180deg, var(--surface), #F7F5EF);
      border-color: var(--border-strong);
    }
    .pager .final:hover { color: var(--accent-dark); }

    /* ── 回到顶部 ── */
    #toTop {
      display: none; position: fixed; right: 18px; bottom: 18px; z-index: 110;
      width: 42px; height: 42px; border-radius: 14px;
      border: 1px solid var(--border-light);
      background: var(--surface);
      color: var(--accent-dark);
      font-size: 17px; cursor: pointer;
      box-shadow: var(--shadow-md);
      transition: all 0.2s var(--ease-out);
    }
    #toTop:hover {
      background: var(--accent); color: #fff;
      border-color: var(--accent);
      transform: translateY(-2px);
    }

    .gallery-foot {
      padding: 8px 20px 40px;
      text-align: center;
      font-size: 12.5px; color: var(--text-muted);
    }
  </style>
</head>
<body>
  <nav id="nav">
    <div class="nav-inner"></div>
  </nav>
  <div id="gallery"></div>
  <button id="toTop" title="回到顶部">↑</button>

  <script is:inline define:vars={{ hash, chapterData, total }}>
    window.__ERNIU_HASH__ = hash;
    window.__ERNIU_DATA__ = chapterData;
    window.__ERNIU_TOTAL__ = total;
  </script>

  <script is:inline>
    (function () {
      var q = new URLSearchParams(location.search).get('q');
      function djb2(s) { var h = 5381, i; for (i = 0; i < s.length; i++) h = ((h << 5) + h + s.charCodeAt(i)) >>> 0; return h; }
      var ok = (q !== null && djb2('lock:' + q) === window.__ERNIU_HASH__);
      if (!ok) return; // 密码不对/缺失 → 保持空白

      var data = window.__ERNIU_DATA__;
      var total = window.__ERNIU_TOTAL__;
      var g = document.getElementById('gallery');
      var nav = document.getElementById('nav').querySelector('.nav-inner');
      var cur = 0; // 当前集索引

      function goTop() {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }

      // ── 渲染当前集 ──
      function render(i) {
        cur = i;
        var ch = data[i];
        g.innerHTML = '';

        // 章节头
        var head = document.createElement('div');
        head.className = 'sec-head';
        var kicker = document.createElement('span');
        kicker.className = 'kicker';
        kicker.textContent = '第 ' + ch.n + ' 话 / 共 ' + total + ' 话';
        var h2 = document.createElement('h2');
        h2.textContent = ch.id + ' ' + ch.title;
        var count = document.createElement('div');
        count.className = 'count';
        count.textContent = '共 ' + ch.imgs.length + ' 页';
        var divider = document.createElement('hr');
        divider.className = 'divider';
        head.appendChild(kicker);
        head.appendChild(h2);
        head.appendChild(count);
        head.appendChild(divider);
        g.appendChild(head);

        // 本集全部图片
        for (var j = 0; j < ch.imgs.length; j++) {
          var fr = document.createElement('div');
          fr.className = 'frame';
          var img = document.createElement('img');
          img.src = ch.imgs[j].u;
          img.loading = 'lazy';
          img.alt = ch.id + ' ' + (j + 1);
          img.referrerPolicy = 'no-referrer';
          fr.appendChild(img);
          g.appendChild(fr);
        }

        // 上/下一集
        var pager = document.createElement('div');
        pager.className = 'pager';
        var prevBtn = document.createElement('button');
        prevBtn.innerHTML = '← 上一集';
        var prevSub = document.createElement('span');
        prevSub.className = 'sub';
        if (i > 0) {
          prevSub.textContent = data[i - 1].id + ' ' + data[i - 1].title;
          prevBtn.appendChild(prevSub);
          prevBtn.onclick = function () { render(i - 1); goTop(); };
        } else {
          prevSub.textContent = '已经是第一集';
          prevBtn.appendChild(prevSub);
          prevBtn.disabled = true;
        }
        var nextBtn = document.createElement('button');
        if (i < total - 1) {
          nextBtn.innerHTML = '下一集 →';
          var nextSub = document.createElement('span');
          nextSub.className = 'sub';
          nextSub.textContent = data[i + 1].id + ' ' + data[i + 1].title;
          nextBtn.appendChild(nextSub);
          nextBtn.onclick = function () { render(i + 1); goTop(); };
        } else {
          nextBtn.className = 'final';
          nextBtn.innerHTML = '🎉 全剧终 · 回到开头';
          nextBtn.onclick = function () { render(0); goTop(); };
        }
        pager.appendChild(prevBtn);
        pager.appendChild(nextBtn);
        g.appendChild(pager);

        // 高亮导航 chip
        var chips = nav.querySelectorAll('.chip');
        for (var k = 0; k < chips.length; k++) {
          chips[k].classList.toggle('active', Number(chips[k].getAttribute('data-i')) === i);
        }
        var active = nav.querySelector('.chip.active');
        if (active) active.scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'smooth' });

        if (document.title === '') document.title = ch.id + ' ' + ch.title + ' — 二牛';
        else document.title = ch.id + ' ' + ch.title + ' — 二牛';
      }

      // ── 导航条：品牌 + 章节 chips ──
      var brand = document.createElement('span');
      brand.className = 'brand';
      brand.innerHTML = '<em>📖</em> 二牛';
      brand.title = '回到第一集';
      brand.onclick = function () { render(0); goTop(); };
      nav.appendChild(brand);

      for (var i = 0; i < total; i++) {
        var chip = document.createElement('span');
        chip.className = 'chip';
        chip.textContent = data[i].id + (data[i].title ? '·' + data[i].title.slice(0, 4) : '');
        chip.setAttribute('data-i', i);
        (function (idx) {
          chip.onclick = function () { render(idx); goTop(); };
        })(i);
        nav.appendChild(chip);
      }

      // 回到顶部按钮
      document.getElementById('toTop').addEventListener('click', goTop);

      // 显示并渲染第一集
      g.style.display = 'block';
      document.getElementById('nav').style.display = 'block';
      document.getElementById('toTop').style.display = 'block';
      render(0);
    })();
  </script>
</body>
</html>