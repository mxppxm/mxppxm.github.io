---
import { ERNIU_ITEMS, ERNIU_HASH } from '../../data/erniu-gallery.mjs';

// 按章节分组，保持阅读顺序
const chapters = [];
const map = new Map();
for (const it of ERNIU_ITEMS) {
  if (!map.has(it.c)) { map.set(it.c, []); chapters.push(it.c); }
  map.get(it.c).push(it);
}
const chapterData = chapters.map((c, i) => ({
  id: c,
  title: map.get(c)[0].t || '',
  imgs: map.get(c),
  n: i + 1
}));
const hash = Number(ERNIU_HASH);
const total = chapters.length;
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title></title>
  <style is:inline>
    /* ═══ 九日 Blog — 纸墨质感 · 与博客文章同款设计语言 ═══ */
    :root {
      --accent: #07C160;
      --accent-dark: #048C48;
      --accent-light: #E8F8EE;
      --bg: #FCFAF7;
      --surface: #FFFFFF;
      --text: #1B1816;
      --text-secondary: #544F49;
      --text-muted: #8A8278;
      --ink: #3A342E;
      --border: #E6E0D6;
      --border-light: #F0EBE3;
      --border-strong: #D5CEC2;
      --shadow-xs: 0 1px 2px rgba(0,0,0,0.04);
      --shadow-sm: 0 1px 3px rgba(0,0,0,0.05), 0 4px 8px rgba(0,0,0,0.03);
      --shadow-md: 0 2px 8px rgba(0,0,0,0.06), 0 8px 20px rgba(0,0,0,0.04);
      --shadow-lg: 0 4px 16px rgba(0,0,0,0.07), 0 16px 40px rgba(0,0,0,0.05);
      --radius-sm: 6px;
      --radius: 10px;
      --radius-lg: 16px;
      --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
    }
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Noto Sans SC", sans-serif;
      background:
        radial-gradient(ellipse 50% 25% at 50% 0%, rgba(0,0,0,0.015) 0%, transparent 60%),
        var(--bg);
      color: var(--text);
      line-height: 1.75;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      min-height: 100vh;
      position: relative;
    }

    /* ── 顶部章节导航（sticky，毛玻璃） ── */
    #nav {
      display: none;
      position: sticky; top: 0; z-index: 100;
      background: rgba(252,250,247,0.88);
      backdrop-filter: blur(16px) saturate(160%);
      -webkit-backdrop-filter: blur(16px) saturate(160%);
      border-bottom: 1px solid var(--border-light);
    }
    #nav .nav-inner {
      max-width: 820px; margin: 0 auto;
      display: flex; align-items: center; gap: 6px;
      padding: 10px 18px;
      overflow-x: auto; scrollbar-width: none;
    }
    #nav .nav-inner::-webkit-scrollbar { display: none; }
    #nav .brand {
      font-weight: 750; font-size: 15px; color: var(--text);
      text-decoration: none; white-space: nowrap;
      margin-right: 10px; letter-spacing: -0.3px;
      display: inline-flex; align-items: center; gap: 6px;
    }
    #nav .brand em {
      font-style: normal; color: var(--accent);
    }
    #nav a.chip {
      flex: 0 0 auto; text-decoration: none;
      color: var(--text-secondary); font-size: 12.5px; font-weight: 520;
      padding: 6px 13px; border-radius: 999px;
      background: var(--surface);
      border: 1px solid var(--border-light);
      transition: all 0.2s var(--ease-out);
    }
    #nav a.chip:hover { color: var(--accent); border-color: rgba(7,193,96,0.4); background: var(--accent-light); }
    #nav a.chip.active {
      color: var(--accent-dark);
      background: var(--accent-light);
      border-color: var(--accent);
      font-weight: 650;
    }

    /* ── 画廊主体 ── */
    #gallery { display: none; }
    .sec { max-width: 820px; margin: 0 auto; padding: 0 0 8px; scroll-margin-top: 64px; }

    /* 章节头 —— 编辑部章节开篇风格 */
    .sec-head {
      display: flex; align-items: baseline; justify-content: space-between;
      padding: 44px 20px 12px;
      margin-bottom: 20px;
    }
    .sec-head .kicker {
      display: inline-block; font-size: 12px; font-weight: 620;
      color: var(--accent-dark); background: var(--accent-light);
      padding: 3px 12px; border-radius: 8px;
      letter-spacing: 0.5px; margin-bottom: 10px;
    }
    .sec-head h2 {
      font-size: clamp(22px, 3.2vw, 28px);
      font-weight: 740; color: var(--text);
      letter-spacing: -0.5px; line-height: 1.3;
    }
    .sec-head .count {
      font-size: 13px; color: var(--text-muted);
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
    }
    .sec-head .divider {
      height: 2px; background: var(--border);
      border: none; margin: 14px 0 0;
    }

    /* 分镜图 —— 白卡片 + 柔和阴影 */
    .frame { padding: 0 20px 14px; }
    .frame img {
      width: 100%; height: auto; display: block;
      border-radius: 12px;
      background: var(--surface);
      box-shadow: var(--shadow-md);
      transition: transform 0.25s var(--ease-out), box-shadow 0.25s var(--ease-out);
    }
    @media (hover: hover) {
      .frame img:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-lg);
      }
    }

    /* ── 下一集按钮 ── */
    .next-box { max-width: 820px; margin: 0 auto; padding: 8px 20px 44px; }
    .next-box a {
      display: flex; align-items: center; justify-content: center; gap: 8px;
      flex-direction: column;
      text-align: center; text-decoration: none;
      background: var(--surface);
      color: var(--accent-dark);
      border: 1.5px solid var(--border);
      border-radius: var(--radius);
      padding: 16px 20px;
      font-size: 15px; font-weight: 650;
      box-shadow: var(--shadow-xs);
      transition: all 0.25s var(--ease-out);
    }
    .next-box a:hover {
      border-color: var(--accent);
      background: var(--accent-light);
      transform: translateY(-1px);
      box-shadow: var(--shadow-accent, 0 2px 12px rgba(7,193,96,0.18));
    }
    .next-box a .main { display: flex; align-items: center; gap: 8px; }
    .next-box a .sub {
      display: block; font-size: 12.5px; font-weight: 400;
      color: var(--text-muted); margin-top: 1px;
    }
    .next-box a:hover .sub { color: var(--accent-dark); }
    .next-box .final {
      color: var(--text);
      background: linear-gradient(180deg, var(--surface), #F7F5EF);
    }
    .next-box .final:hover { color: var(--accent-dark); }

    /* ── 回到顶部 ── */
    #toTop {
      display: none; position: fixed; right: 18px; bottom: 18px; z-index: 110;
      width: 42px; height: 42px; border-radius: 14px;
      border: 1px solid var(--border-light);
      background: var(--surface);
      color: var(--accent-dark);
      font-size: 17px; cursor: pointer;
      box-shadow: var(--shadow-md);
      transition: all 0.2s var(--ease-out);
    }
    #toTop:hover {
      background: var(--accent); color: #fff;
      border-color: var(--accent);
      transform: translateY(-2px);
    }

    /* ── 带密码的页脚小提示 ── */
    .gallery-foot {
      max-width: 820px; margin: 0 auto;
      padding: 8px 20px 40px;
      text-align: center;
      font-size: 12.5px; color: var(--text-muted);
    }
  </style>
</head>
<body>
  <nav id="nav">
    <div class="nav-inner"></div>
  </nav>
  <div id="gallery"></div>
  <button id="toTop" title="回到顶部">↑</button>

  <script is:inline define:vars={{ hash, chapterData, total }}>
    window.__ERNIU_HASH__ = hash;
    window.__ERNIU_DATA__ = chapterData;
    window.__ERNIU_TOTAL__ = total;
  </script>

  <script is:inline>
    (function () {
      var q = new URLSearchParams(location.search).get('q');
      function djb2(s) { var h = 5381, i; for (i = 0; i < s.length; i++) h = ((h << 5) + h + s.charCodeAt(i)) >>> 0; return h; }
      var ok = (q !== null && djb2('lock:' + q) === window.__ERNIU_HASH__);
      if (!ok) return; // 密码不对/缺失 → 保持空白

      var data = window.__ERNIU_DATA__;
      var total = window.__ERNIU_TOTAL__;
      var g = document.getElementById('gallery');
      var nav = document.getElementById('nav').querySelector('.nav-inner');
      var i, j, ch, sec, head, kicker, h2, count, divider, fr, img, chip, nextBox, a, main, sub, foot;

      // 导航品牌 + 章节 chips
      var brand = document.createElement('a');
      brand.className = 'brand';
      brand.href = '#top';
      brand.innerHTML = '<em>📖</em> 二牛';
      nav.appendChild(brand);

      for (i = 0; i < total; i++) {
        chip = document.createElement('a');
        chip.className = 'chip';
        chip.href = '#c-' + data[i].id;
        chip.textContent = data[i].id + (data[i].title ? '·' + data[i].title.slice(0, 4) : '');
        chip.setAttribute('data-cid', data[i].id);
        nav.appendChild(chip);
      }

      // 画廊正文
      for (i = 0; i < total; i++) {
        ch = data[i];
        sec = document.createElement('section');
        sec.className = 'sec';
        sec.id = 'c-' + ch.id;

        head = document.createElement('div');
        head.className = 'sec-head';
        kicker = document.createElement('span');
        kicker.className = 'kicker';
        kicker.textContent = '第 ' + ch.n + ' 话';
        h2 = document.createElement('h2');
        h2.textContent = ch.id + ' ' + ch.title;
        count = document.createElement('span');
        count.className = 'count';
        count.textContent = ch.imgs.length + ' 页';
        divider = document.createElement('hr');
        divider.className = 'divider';
        head.appendChild(kicker);
        head.appendChild(h2);
        head.appendChild(count);
        head.appendChild(divider);
        sec.appendChild(head);

        for (j = 0; j < ch.imgs.length; j++) {
          fr = document.createElement('div');
          fr.className = 'frame';
          img = document.createElement('img');
          img.src = ch.imgs[j].u;
          img.loading = 'lazy';
          img.alt = ch.id + ' ' + (j + 1);
          img.referrerPolicy = 'no-referrer';
          fr.appendChild(img);
          sec.appendChild(fr);
        }
        g.appendChild(sec);

        // 下一集 / 全剧终
        nextBox = document.createElement('div');
        nextBox.className = 'next-box';
        a = document.createElement('a');
        main = document.createElement('span');
        main.className = 'main';
        if (i < total - 1) {
          a.href = '#c-' + data[i + 1].id;
          main.textContent = '下一集 · ' + data[i + 1].id;
          sub = document.createElement('span');
          sub.className = 'sub';
          sub.textContent = data[i + 1].title;
          a.appendChild(main);
          a.appendChild(sub);
        } else {
          a.className = 'final';
          a.href = '#top';
          main.textContent = '🎉 全剧终 · 回到顶部';
          a.appendChild(main);
        }
        nextBox.appendChild(a);
        g.appendChild(nextBox);
      }

      // 页脚
      foot = document.createElement('div');
      foot.className = 'gallery-foot';
      foot.textContent = '—— 二牛 · 完 ——';
      g.appendChild(foot);

      g.style.display = 'block';
      document.getElementById('nav').style.display = 'block';
      document.getElementById('toTop').style.display = 'block';
      if (document.title === '') document.title = '二牛 — 九日';

      // 滚动时高亮当前章节 chip
      var chips = document.querySelectorAll('#nav .chip');
      function deactivate() {
        for (var k = 0; k < chips.length; k++) chips[k].classList.remove('active');
      }
      function onScroll() {
        var sections = document.querySelectorAll('.sec');
        var curId = null;
        for (var k = 0; k < sections.length; k++) {
          if (sections[k].getBoundingClientRect().top <= 96) curId = sections[k].id;
        }
        if (curId) {
          deactivate();
          var target = document.querySelector('#nav .chip[data-cid="' + curId.slice(2) + '"]');
          if (target) {
            target.classList.add('active');
            target.scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'smooth' });
          }
        }
      }
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // 回到顶部
      document.getElementById('toTop').addEventListener('click', function () {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    })();
  </script>
</body>
</html>