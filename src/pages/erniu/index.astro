---
import { ERNIU_ITEMS, ERNIU_HASH } from '../../data/erniu-gallery.mjs';

// 按章节分组，保持阅读顺序
const chapters = [];
const map = new Map();
for (const it of ERNIU_ITEMS) {
  if (!map.has(it.c)) { map.set(it.c, []); chapters.push(it.c); }
  map.get(it.c).push(it);
}
const chapterData = chapters.map((c, i) => ({
  id: c,
  title: map.get(c)[0].t || '',
  imgs: map.get(c),
  n: i + 1
}));
const hash = Number(ERNIU_HASH);
const total = chapters.length;
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title></title>
  <style>
    :root { --bg: #0f0e0c; --card: #191612; --line: #2c261d; --ink: #e6d6b6; --dim: #a08f74; --acc: #d9a15e; }
    html, body { margin: 0; padding: 0; background: var(--bg); color: var(--ink); font-family: system-ui, -apple-system, sans-serif; }
    /* 顶部章节导航栏 */
    #nav { display: none; position: sticky; top: 0; z-index: 50; background: rgba(15,14,12,.92); backdrop-filter: blur(8px); border-bottom: 1px solid var(--line); }
    #nav .nav-inner { max-width: 560px; margin: 0 auto; display: flex; align-items: center; gap: 4px; padding: 8px 10px; overflow-x: auto; scrollbar-width: none; }
    #nav .nav-inner::-webkit-scrollbar { display: none; }
    #nav .brand { font-weight: 700; font-size: 14px; color: var(--acc); white-space: nowrap; padding: 0 8px 0 0; }
    #nav a.chip {
      flex: 0 0 auto; text-decoration: none; color: var(--dim); font-size: 12px;
      padding: 5px 10px; border-radius: 999px; border: 1px solid var(--line);
      transition: all .15s;
    }
    #nav a.chip:hover { color: var(--ink); border-color: var(--dim); }
    #nav a.chip.active { color: #1a140c; background: var(--acc); border-color: var(--acc); font-weight: 600; }
    /* 画廊主体 */
    #gallery { display: none; }
    .sec { max-width: 560px; margin: 0 auto; padding: 0 0 10px; scroll-margin-top: 58px; }
    .sec-head { display: flex; align-items: baseline; justify-content: space-between; padding: 26px 16px 10px; }
    .sec-head h2 { margin: 0; font-size: 17px; color: var(--ink); letter-spacing: .5px; }
    .sec-head .count { font-size: 12px; color: var(--dim); }
    .frame { padding: 0 12px 12px; }
    .frame img {
      width: 100%; height: auto; display: block; border-radius: 10px;
      background: #000; box-shadow: 0 2px 14px rgba(0,0,0,.5);
    }
    /* 下一集按钮 */
    .next-box { max-width: 560px; margin: 0 auto; padding: 4px 16px 26px; }
    .next-box a {
      display: block; text-align: center; text-decoration: none;
      background: var(--card); color: var(--acc); border: 1px solid var(--line);
      border-radius: 12px; padding: 12px; font-size: 14px; font-weight: 600;
      transition: all .15s;
    }
    .next-box a:hover { background: var(--acc); color: #1a140c; }
    .next-box a .sub { display: block; font-size: 11px; font-weight: 400; color: var(--dim); margin-top: 2px; }
    .next-box a:hover .sub { color: rgba(26,20,12,.7); }
    /* 回到顶部 */
    #toTop {
      display: none; position: fixed; right: 16px; bottom: 16px; z-index: 60;
      width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--line);
      background: var(--card); color: var(--acc); font-size: 18px; cursor: pointer;
    }
  </style>
</head>
<body>
  <nav id="nav"><div class="nav-inner"></div></nav>
  <div id="gallery"></div>
  <button id="toTop" title="回到顶部">↑</button>

  <script is:inline define:vars={{ hash, chapterData, total }}>
    window.__ERNIU_HASH__ = hash;
    window.__ERNIU_DATA__ = chapterData;
    window.__ERNIU_TOTAL__ = total;
  </script>

  <script is:inline>
    (function () {
      var q = new URLSearchParams(location.search).get('q');
      function djb2(s) { var h = 5381, i; for (i = 0; i < s.length; i++) h = ((h << 5) + h + s.charCodeAt(i)) >>> 0; return h; }
      var ok = (q !== null && djb2('lock:' + q) === window.__ERNIU_HASH__);
      if (!ok) return; // 密码不对/缺失 → 保持空白

      var data = window.__ERNIU_DATA__;
      var total = window.__ERNIU_TOTAL__;
      var g = document.getElementById('gallery');
      var nav = document.getElementById('nav').querySelector('.nav-inner');
      var i, j, ch, sec, head, h2, count, fr, img, chip, nextBox, a, sub;

      // 章节导航 chips
      for (i = 0; i < total; i++) {
        chip = document.createElement('a');
        chip.className = 'chip';
        chip.href = '#c-' + data[i].id;
        chip.textContent = data[i].id + (data[i].title ? '·' + data[i].title.slice(0, 4) : '');
        chip.setAttribute('data-cid', data[i].id);
        nav.appendChild(chip);
      }

      // 画廊正文
      for (i = 0; i < total; i++) {
        ch = data[i];
        sec = document.createElement('section');
        sec.className = 'sec';
        sec.id = 'c-' + ch.id;

        head = document.createElement('div');
        head.className = 'sec-head';
        h2 = document.createElement('h2');
        h2.textContent = ch.id + ' ' + ch.title;
        count = document.createElement('span');
        count.className = 'count';
        count.textContent = ch.imgs.length + ' 页';
        head.appendChild(h2);
        head.appendChild(count);
        sec.appendChild(head);

        for (j = 0; j < ch.imgs.length; j++) {
          fr = document.createElement('div');
          fr.className = 'frame';
          img = document.createElement('img');
          img.src = ch.imgs[j].u;
          img.loading = 'lazy';
          img.alt = ch.id + ' ' + (j + 1);
          img.referrerPolicy = 'no-referrer';
          fr.appendChild(img);
          sec.appendChild(fr);
        }
        g.appendChild(sec);

        // 下一集按钮（最后一集显示回到顶部）
        nextBox = document.createElement('div');
        nextBox.className = 'next-box';
        a = document.createElement('a');
        if (i < total - 1) {
          a.href = '#c-' + data[i + 1].id;
          a.textContent = '下一集 · ' + data[i + 1].id;
          sub = document.createElement('span');
          sub.className = 'sub';
          sub.textContent = data[i + 1].title;
          a.appendChild(sub);
        } else {
          a.href = '#top';
          a.textContent = '🎉 全剧终 · 回到顶部';
        }
        nextBox.appendChild(a);
        g.appendChild(nextBox);
      }

      g.style.display = 'block';
      document.getElementById('nav').style.display = 'block';
      document.getElementById('toTop').style.display = 'block';
      if (document.title === '') document.title = '📖 二牛';

      // 滚动时高亮当前章节 chip
      var chips = document.querySelectorAll('#nav .chip');
      function deactivate() {
        for (var k = 0; k < chips.length; k++) chips[k].classList.remove('active');
      }
      function onScroll() {
        var sections = document.querySelectorAll('.sec');
        var curId = null;
        for (var k = 0; k < sections.length; k++) {
          if (sections[k].getBoundingClientRect().top <= 80) curId = sections[k].id;
        }
        if (curId) {
          deactivate();
          var target = document.querySelector('#nav .chip[data-cid="' + curId.slice(2) + '"]');
          if (target) {
            target.classList.add('active');
            target.scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'smooth' });
          }
        }
      }
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    })();
  </script>
</body>
</html>