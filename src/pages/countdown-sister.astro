---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="妹妹的 20 岁生日倒计时"
  description="倒计时到 2026-11-01，妹妹的 20 岁生日。"
>
  <main class="countdown-page">
    <section class="countdown-card">
      <span class="emoji" id="emoji">💜</span>
      <h1 class="countdown-title">妹妹的 20 岁生日倒计时</h1>
      <p class="countdown-sub">
        目标时刻 <span class="target">2026-11-01 00:00</span>（北京时间）
      </p>

      <div class="timer" id="timer">
        <div class="unit">
          <div class="num" id="days">—</div>
          <div class="label">天</div>
        </div>
        <div class="sep">:</div>
        <div class="unit">
          <div class="num" id="hours">—</div>
          <div class="label">小时</div>
        </div>
        <div class="sep">:</div>
        <div class="unit">
          <div class="num" id="mins">—</div>
          <div class="label">分钟</div>
        </div>
        <div class="sep">:</div>
        <div class="unit sec">
          <div class="num" id="secs">—</div>
          <div class="label">秒</div>
        </div>
      </div>

      <p class="wish" id="wish">愿你今天遇到的每一件小事，都刚刚好顺心 🌸</p>
    </section>
  </main>
</BaseLayout>

<script>
  const TARGET = new Date("2026-11-01T00:00:00+08:00");

  const el = (id) => document.getElementById(id);
  const pad = (n) => String(n).padStart(2, "0");

  // 祝福池：与邮件脚本 send_countdown_sister.rb 保持同步（60 条）
  // 选取规则同邮件——按「封」递增：上午(9:00)=0 / 下午晚上(23:00)=1，故同一天也各不相同
  const WISHES = [
    "愿你今天遇到的每一件小事，都刚刚好顺心 🌸",
    "二十岁前的每一天，都值得被认真喜欢 💜",
    "记得喝水，记得笑，记得你比想象中更厉害 ✨",
    "今天的你，已经很棒了，剩下的交给时间 🌷",
    "愿你眼里有光，心里有糖，出门有风 🍬",
    "慢慢来，比较快。你走的每一步都算数 🐾",
    "愿今天有一件小事让你偷偷开心一整天 🌼",
    "你不需要长成别人的样子，做自己就很好 ✨",
    "把烦恼交给明天，今天先好好吃一顿饭 🍜",
    "愿你被这世界温柔以待，也温柔待自己 🫧",
    "又近了一天，你离闪闪发光的二十岁又近了一步 ⭐",
    "今天也要做那个，笑起来最好看的人呀 😊",
    "愿你所有的努力都被看见，所有的期待都有回响 🎐",
    "别急，好事会来的，而且只属于你 🍀",
    "愿你像春天一样，温柔又有力量 🌱",
    "今天如果有乌云，就想想我这句话：都会好的 ☀️",
    "二十岁是一场盛大的开始，你值得一切美好 🎉",
    "愿你做喜欢的事，见喜欢的人，过喜欢的日子 🌈",
    "累了就歇一会儿，世界不会因为你慢一点而跑掉 🛋️",
    "愿今天的风，把好运都吹到你身边 🍃",
    "你是我心里最会发光的小孩，一直都是 💫",
    "愿你笑得像糖，活得漂亮 🍭",
    "每一天的等待，都是为了那天更好的相遇 🎁",
    "今天也要好好爱自己呀，这是最重要的事 💝",
    "愿你睡个好觉，做个好梦，醒来元气满满 🛏️",
    "再等等，蛋糕、蜡烛和祝福都在路上了 🎂",
    "愿你平安喜乐，万事胜意，比昨天更靠近幸福 🌟",
    "记得抬头看看天，今天的云是为你准备的 ☁️",
    "你已经很棒啦，记得给自己一点掌声 👏",
    "愿你今天的每一步，都踩在自己想走的路上 🚶‍♀️",
    "想做的事就去做，你从来不缺勇气 🕊️",
    "愿你的日子像柠檬汽水，冒着小气泡的甜 🥤",
    "今天也值得被认真过，哪怕只是好好睡一觉 🌙",
    "你比自己想的更勇敢，也比自己想的更温柔 🧸",
    "愿你身边永远有人懂你，不必费力解释 🌻",
    "世界很大，但总会有一处角落为你亮着灯 🏮",
    "愿你不慌不忙，把日子过成自己喜欢的样子 🍵",
    "今天的好运已经在路上了，记得签收 📦",
    "你走的每一步，都在把你带向更好的地方 🧭",
    "愿你被人惦记，被人偏爱，被人好好对待 🫶",
    "二十岁的样子，一定是很好看的样子 📷",
    "愿你哭的时候有人递纸，笑的时候有人陪着 🎠",
    "别把喜欢的事丢了，它会一直等你 🎨",
    "愿你今天的努力，明天就有回音 📮",
    "你已经被很多人悄悄爱着了呀 🥰",
    "愿你像小太阳一样，走到哪里都暖和 ☀️",
    "今天的你，值得一杯喜欢的奶茶 🧋",
    "愿你所有的疲惫，都能被一场好觉治愈 🛌",
    "想家的时候就抬头，月亮在哪都一样 🌕",
    "愿你的小愿望，一个一个都被实现 🪄",
    "你不需要完美，你只要是你自己 🌼",
    "愿你遇到的人，都温柔，都真诚 🤝",
    "今天也请多夸夸自己，你值得 🤗",
    "愿你心里的那束光，永远不会灭 🔆",
    "二十岁要来了，你的好日子也一起来了 🚀",
    "愿你每天都有小确幸，攒成一大罐的开心 🍯",
    "你值得一切发生得好，也值得一切慢慢来 🌾",
    "愿你走路带风，眼里带笑，心里带光 ⚡",
    "今天记得对自己说一句：辛苦了，很值得 🌷",
    "愿你被生活温柔抱住，哪怕只是今天一天 🫂",
  ];

  function wishOf(d = new Date()) {
    const yday = Math.floor((d - new Date(d.getFullYear(), 0, 0)) / 86400000);
    const slot = d.getHours() >= 12 ? 1 : 0;
    return WISHES[(yday * 2 + slot) % WISHES.length];
  }

  function tick() {
    el("wish").textContent = wishOf();
    const diffMs = TARGET - Date.now();
    const emoji = el("emoji");
    const title = document.querySelector(".countdown-title");

    if (diffMs <= 0) {
      emoji.textContent = "🎉";
      title.textContent = "妹妹 20 岁生日快乐！";
      el("days").textContent = "00";
      el("hours").textContent = "00";
      el("mins").textContent = "00";
      el("secs").textContent = "00";
      return;
    }

    const secTotal = Math.floor(diffMs / 1000);
    const days = Math.floor(secTotal / 86400);
    const hours = Math.floor((secTotal % 86400) / 3600);
    const mins = Math.floor((secTotal % 3600) / 60);
    const secs = secTotal % 60;

    el("days").textContent = pad(days);
    el("hours").textContent = pad(hours);
    el("mins").textContent = pad(mins);
    el("secs").textContent = pad(secs);

    // 秒格每跳一次闪一下
    el("secs").classList.remove("flash");
    void el("secs").offsetWidth; // 重排以重新触发动画
    el("secs").classList.add("flash");
  }

  tick();
  setInterval(tick, 1000);
</script>

<style>
  .countdown-page {
    min-height: 72vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 120px 20px 48px;
  }
  .countdown-card {
    background: #f5f3ff;
    border: 1.5px solid #ddd6fe;
    border-radius: var(--radius-xl);
    padding: 48px 40px;
    max-width: 620px;
    width: 100%;
    text-align: center;
    box-shadow: var(--shadow-lg);
  }
  .emoji {
    display: inline-block;
    font-size: 56px;
    margin-bottom: 8px;
    animation: floaty 3s ease-in-out infinite;
  }
  @keyframes floaty {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }
  .countdown-title {
    font-size: 28px;
    font-weight: 800;
    color: #5b21b6;
    margin: 0 0 6px;
  }
  .countdown-sub {
    font-size: 14px;
    color: #7c3aed;
    opacity: 0.8;
    margin: 0 0 28px;
  }
  .target {
    color: #7c3aed;
    font-weight: 700;
  }
  .timer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-bottom: 28px;
  }
  .unit {
    background: #ede9fe;
    border: 1px solid #ddd6fe;
    border-radius: var(--radius);
    padding: 14px 10px;
    min-width: 76px;
  }
  .unit.sec {
    background: #a78bfa;
    border-color: #a78bfa;
  }
  .num {
    font-size: 40px;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    color: #5b21b6;
    line-height: 1.1;
  }
  .sec .num {
    color: #fff;
  }
  .num.flash {
    animation: pop 0.4s var(--ease-spring);
  }
  @keyframes pop {
    0% { transform: scale(1); }
    40% { transform: scale(1.25); }
    100% { transform: scale(1); }
  }
  .label {
    font-size: 13px;
    color: #7c3aed;
    opacity: 0.85;
    margin-top: 4px;
  }
  .sec .label {
    color: #ede9fe;
    opacity: 1;
  }
  .sep {
    font-size: 32px;
    font-weight: 700;
    color: #c4b5fd;
  }
  .wish {
    font-size: 15px;
    color: #5b21b6;
    background: #fff;
    border-left: 4px solid #a78bfa;
    border-radius: 0 10px 10px 0;
    padding: 12px 16px;
    margin: 0;
    text-align: left;
  }

  @media (max-width: 480px) {
    .countdown-card { padding: 32px 18px; }
    .timer { gap: 6px; }
    .unit { min-width: 62px; padding: 10px 6px; }
    .num { font-size: 30px; }
    .sep { font-size: 24px; }
  }
</style>