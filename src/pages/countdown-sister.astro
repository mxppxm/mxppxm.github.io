---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="妹妹的 20 岁生日倒计时"
  description="倒计时到 2026-11-01，妹妹的 20 岁生日。"
>
  <main class="countdown-page">
    <section class="countdown-card">
      <span class="emoji" id="emoji">💜</span>
      <h1 class="countdown-title">妹妹的 20 岁生日倒计时</h1>
      <p class="countdown-sub">
        目标时刻 <span class="target">2026-11-01 00:00</span>（北京时间）
      </p>

      <div class="timer" id="timer">
        <div class="unit">
          <div class="num" id="days">—</div>
          <div class="label">天</div>
        </div>
        <div class="sep">:</div>
        <div class="unit">
          <div class="num" id="hours">—</div>
          <div class="label">小时</div>
        </div>
        <div class="sep">:</div>
        <div class="unit">
          <div class="num" id="mins">—</div>
          <div class="label">分钟</div>
        </div>
        <div class="sep">:</div>
        <div class="unit sec">
          <div class="num" id="secs">—</div>
          <div class="label">秒</div>
        </div>
      </div>

      <p class="wish" id="wish">愿你的二十岁，从一场大大的惊喜开始 🎈</p>
    </section>
  </main>
</BaseLayout>

<script>
  const TARGET = new Date("2026-11-01T00:00:00+08:00");

  const el = (id) => document.getElementById(id);
  const pad = (n) => String(n).padStart(2, "0");

  function tick() {
    const diffMs = TARGET - Date.now();
    const emoji = el("emoji");
    const title = document.querySelector(".countdown-title");

    if (diffMs <= 0) {
      emoji.textContent = "🎉";
      title.textContent = "妹妹 20 岁生日快乐！";
      el("days").textContent = "00";
      el("hours").textContent = "00";
      el("mins").textContent = "00";
      el("secs").textContent = "00";
      return;
    }

    const secTotal = Math.floor(diffMs / 1000);
    const days = Math.floor(secTotal / 86400);
    const hours = Math.floor((secTotal % 86400) / 3600);
    const mins = Math.floor((secTotal % 3600) / 60);
    const secs = secTotal % 60;

    el("days").textContent = pad(days);
    el("hours").textContent = pad(hours);
    el("mins").textContent = pad(mins);
    el("secs").textContent = pad(secs);

    // 秒格每跳一次闪一下
    el("secs").classList.remove("flash");
    void el("secs").offsetWidth; // 重排以重新触发动画
    el("secs").classList.add("flash");
  }

  tick();
  setInterval(tick, 1000);
</script>

<style>
  .countdown-page {
    min-height: 72vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 120px 20px 48px;
  }
  .countdown-card {
    background: #f5f3ff;
    border: 1.5px solid #ddd6fe;
    border-radius: var(--radius-xl);
    padding: 48px 40px;
    max-width: 620px;
    width: 100%;
    text-align: center;
    box-shadow: var(--shadow-lg);
  }
  .emoji {
    display: inline-block;
    font-size: 56px;
    margin-bottom: 8px;
    animation: floaty 3s ease-in-out infinite;
  }
  @keyframes floaty {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }
  .countdown-title {
    font-size: 28px;
    font-weight: 800;
    color: #5b21b6;
    margin: 0 0 6px;
  }
  .countdown-sub {
    font-size: 14px;
    color: #7c3aed;
    opacity: 0.8;
    margin: 0 0 28px;
  }
  .target {
    color: #7c3aed;
    font-weight: 700;
  }
  .timer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-bottom: 28px;
  }
  .unit {
    background: #ede9fe;
    border: 1px solid #ddd6fe;
    border-radius: var(--radius);
    padding: 14px 10px;
    min-width: 76px;
  }
  .unit.sec {
    background: #a78bfa;
    border-color: #a78bfa;
  }
  .num {
    font-size: 40px;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    color: #5b21b6;
    line-height: 1.1;
  }
  .sec .num {
    color: #fff;
  }
  .num.flash {
    animation: pop 0.4s var(--ease-spring);
  }
  @keyframes pop {
    0% { transform: scale(1); }
    40% { transform: scale(1.25); }
    100% { transform: scale(1); }
  }
  .label {
    font-size: 13px;
    color: #7c3aed;
    opacity: 0.85;
    margin-top: 4px;
  }
  .sec .label {
    color: #ede9fe;
    opacity: 1;
  }
  .sep {
    font-size: 32px;
    font-weight: 700;
    color: #c4b5fd;
  }
  .wish {
    font-size: 15px;
    color: #5b21b6;
    background: #fff;
    border-left: 4px solid #a78bfa;
    border-radius: 0 10px 10px 0;
    padding: 12px 16px;
    margin: 0;
    text-align: left;
  }

  @media (max-width: 480px) {
    .countdown-card { padding: 32px 18px; }
    .timer { gap: 6px; }
    .unit { min-width: 62px; padding: 10px 6px; }
    .num { font-size: 30px; }
    .sep { font-size: 24px; }
  }
</style>