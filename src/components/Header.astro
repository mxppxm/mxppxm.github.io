---
// Header component — custom CSS style (green theme)
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="site-title">☀️ 九日</a>
    <nav class="site-nav">
      <a href="/articles/gold/">黄金</a>
      <a href="/articles/novel/">槐树下</a>
      <a href="/articles/comic/">漫画</a>
      <a href="/articles/essays/">杂文</a>
      <a href="/articles/skills/">Skill</a>
      <a href="/articles/poetry/">诗词</a>
      <div class="nav-dropdown">
        <span class="nav-dropdown-trigger">项目 ▾</span>
        <div class="nav-dropdown-menu">
          <a href="https://skin-doctor.netlify.app/" target="_blank" rel="noopener" class="dropdown-project">
            <span class="dropdown-project-icon">
              <img src="/logo.png" alt="皮肤检测器" width="22" height="22" style="border-radius:5px;" />
            </span>
            <div class="dropdown-project-info">
              <div class="dropdown-project-name">皮肤检测器</div>
              <div class="dropdown-project-desc">AI 肤质分析 · skin-doctor.netlify.app</div>
            </div>
            <span class="dropdown-project-arrow">↗</span>
          </a>
        </div>
      </div>
      <a href="https://github.com/mxppxm" target="_blank" rel="noopener">GitHub</a>
      <button class="nav-cooperate-btn" id="cooperate-btn">
        <span class="cooperate-dot"></span> 开放合作
      </button>
    </nav>
    <button class="mobile-menu-btn" onclick="document.querySelector('.mobile-nav').classList.toggle('active')">☰</button>
  </div>
</header>

<nav class="mobile-nav">
  <a href="/articles/gold/">🏆 黄金</a>
  <a href="/articles/novel/">🌳 槐树下</a>
  <a href="/articles/comic/">🎨 漫画</a>
  <a href="/articles/essays/">📝 杂文</a>
  <a href="/articles/skills/">🧰 Skill</a>
  <a href="/articles/poetry/">📜 诗词</a>
  <a href="https://skin-doctor.netlify.app/" target="_blank" rel="noopener">🔬 皮肤检测器</a>
  <a href="https://github.com/mxppxm" target="_blank" rel="noopener">GitHub</a>
  <button class="nav-cooperate-btn mobile" id="cooperate-btn-mobile">
    <span class="cooperate-dot"></span> 开放合作
  </button>
</nav>

<!-- 合作弹窗 -->
<div class="cooperate-overlay" id="cooperate-overlay">
  <div class="cooperate-modal">
    <button class="cooperate-close" id="cooperate-close">&times;</button>
    <span class="cooperate-dot large"></span>
    <h3>开放合作中</h3>
    <p>有想法就聊聊，别客气 👋</p>
    <div class="cooperate-email-row">
      <code id="cooperate-email">2695409102@qq.com</code>
      <button class="cooperate-copy-btn" id="cooperate-copy-btn">复制</button>
    </div>
    <span class="cooperate-copied" id="cooperate-copied">已复制 ✓</span>

    <div class="cooperate-subscribe">
      <p class="cooperate-subscribe-title">💌 或者订阅更新</p>
      <p class="cooperate-subscribe-desc">留个邮箱，新文章发布后第一时间邮件通知你，随时可退订。</p>
      <form id="subscribe-form" class="subscribe-form" novalidate>
        <input
          type="email"
          id="subscribe-email"
          class="subscribe-input"
          placeholder="you@example.com"
          required
          autocomplete="email"
        />
        <button type="submit" class="subscribe-btn" id="subscribe-btn">订阅</button>
      </form>
      <p class="subscribe-msg" id="subscribe-msg"></p>
    </div>
  </div>
</div>

<style is:global>
  .nav-cooperate-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 620;
    color: var(--accent-dark);
    background: var(--accent-light);
    padding: 5px 14px;
    border-radius: 20px;
    border: 1px solid rgba(7,193,96,0.14);
    cursor: pointer;
    font-family: inherit;
    transition: background 0.2s, transform 0.2s;
  }
  .nav-cooperate-btn:hover {
    background: rgba(7,193,96,0.18);
    transform: translateY(-1px);
  }

  .nav-cooperate-btn.mobile {
    width: 100%;
    justify-content: center;
    padding: 12px 20px;
    font-size: 15px;
    border-radius: 12px;
  }
  .mobile-nav .nav-cooperate-btn.mobile {
    background: var(--accent-light);
    border: 1px solid rgba(7,193,96,0.14);
    color: var(--accent-dark);
  }

  .cooperate-dot {
    width: 6px; height: 6px;
    background: var(--accent, #07c160);
    border-radius: 50%;
    animation: cooperateDotPulse 2.5s ease-in-out infinite;
    flex-shrink: 0;
  }
  .cooperate-dot.large {
    width: 10px; height: 10px;
    margin-bottom: 12px;
  }
  @keyframes cooperateDotPulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.3; transform: scale(0.8); }
  }

  /* Modal */
  .cooperate-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(0,0,0,0.45);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }
  .cooperate-overlay.open {
    opacity: 1;
    pointer-events: auto;
  }

  .cooperate-modal {
    background: var(--surface, #fff);
    border-radius: 20px;
    padding: 40px 36px 32px;
    text-align: center;
    max-width: 380px;
    width: 90%;
    position: relative;
    box-shadow: 0 20px 60px rgba(0,0,0,0.2);
    transform: translateY(12px);
    transition: transform 0.25s ease;
  }
  .cooperate-overlay.open .cooperate-modal {
    transform: translateY(0);
  }

  .cooperate-close {
    position: absolute;
    top: 12px; right: 16px;
    background: none; border: none;
    font-size: 24px; color: var(--text-secondary);
    cursor: pointer; line-height: 1;
    padding: 4px 8px; border-radius: 8px;
    transition: background 0.15s;
  }
  .cooperate-close:hover { background: var(--accent-light); }

  .cooperate-modal h3 {
    font-size: 20px; font-weight: 700;
    margin: 0 0 4px;
    color: var(--text-primary);
  }
  .cooperate-modal p {
    font-size: 14px; color: var(--text-secondary);
    margin: 0 0 20px;
  }

  .cooperate-email-row {
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--bg, #f7f5f0);
    border-radius: 12px;
    padding: 6px 6px 6px 16px;
  }
  .cooperate-email-row code {
    font-size: 14px;
    color: var(--text-primary);
    font-family: 'SF Mono', 'Menlo', monospace;
    word-break: break-all;
    flex: 1;
    background: none;
    padding: 0;
  }

  .cooperate-copy-btn {
    flex-shrink: 0;
    background: var(--accent, #07c160);
    color: #fff;
    border: none;
    padding: 8px 18px;
    border-radius: 10px;
    font-size: 13px; font-weight: 600;
    cursor: pointer;
    font-family: inherit;
    transition: background 0.15s, transform 0.15s;
  }
  .cooperate-copy-btn:hover {
    background: #06a050;
  }
  .cooperate-copy-btn:active {
    transform: scale(0.96);
  }

  .cooperate-copied {
    display: inline-block;
    margin-top: 10px;
    font-size: 12px;
    color: var(--accent);
    opacity: 0;
    transition: opacity 0.3s;
  }
  .cooperate-copied.show {
    opacity: 1;
  }

  /* 弹窗内订阅区 */
  .cooperate-subscribe {
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1px solid var(--border, rgba(0,0,0,0.08));
    text-align: left;
  }
  .cooperate-subscribe-title {
    font-size: 15px;
    font-weight: 650;
    margin: 0 0 4px;
    color: var(--text-primary);
  }
  .cooperate-subscribe-desc {
    font-size: 13px;
    color: var(--text-secondary);
    margin: 0 0 12px;
    line-height: 1.5;
  }
  .subscribe-form {
    display: flex;
    gap: 8px;
  }
  .subscribe-input {
    flex: 1;
    min-width: 0;
    padding: 10px 14px;
    border-radius: 10px;
    border: 1.5px solid var(--border-strong, rgba(0,0,0,0.14));
    background: var(--bg, #f7f5f0);
    color: var(--text-primary);
    font-size: 14px;
    font-family: inherit;
    transition: border-color 0.25s, box-shadow 0.25s;
  }
  .subscribe-input:focus {
    outline: none;
    border-color: var(--accent, #07c160);
    box-shadow: 0 0 0 3px rgba(7,193,96,0.15);
  }
  .subscribe-btn {
    flex-shrink: 0;
    padding: 10px 20px;
    border: none;
    border-radius: 10px;
    background: var(--accent, #07c160);
    color: #fff;
    font-size: 13.5px;
    font-weight: 600;
    cursor: pointer;
    font-family: inherit;
    transition: background 0.15s, opacity 0.2s;
  }
  .subscribe-btn:hover { background: #06a050; }
  .subscribe-btn:disabled { opacity: 0.55; cursor: not-allowed; }
  .subscribe-msg {
    font-size: 12.5px;
    margin: 10px 0 0;
    min-height: 1.1rem;
    line-height: 1.5;
  }
  .subscribe-msg.ok { color: var(--accent-dark, #06a050); font-weight: 500; }
  .subscribe-msg.error { color: #d9534f; }
</style>

<script is:inline>
const overlay = document.getElementById('cooperate-overlay');
const emailEl = document.getElementById('cooperate-email');
const copyBtn = document.getElementById('cooperate-copy-btn');
const copiedHint = document.getElementById('cooperate-copied');

function openCooperate() {
  overlay.classList.add('open');
}
function closeCooperate() {
  overlay.classList.remove('open');
}

document.getElementById('cooperate-btn').addEventListener('click', openCooperate);
document.getElementById('cooperate-btn-mobile').addEventListener('click', openCooperate);
document.getElementById('cooperate-close').addEventListener('click', closeCooperate);
overlay.addEventListener('click', function(e) {
  if (e.target === overlay) closeCooperate();
});

copyBtn.addEventListener('click', function() {
  navigator.clipboard.writeText(emailEl.textContent).then(function() {
    copiedHint.classList.add('show');
    copyBtn.textContent = '已复制';
    setTimeout(function() {
      copiedHint.classList.remove('show');
      copyBtn.textContent = '复制';
    }, 2000);
  });
});

/* ---- 邮件订阅（弹窗内） ---- */
// JSONBin 后端：access key 仅授予「创建订阅」权限（不可读取列表），见 notify_subscribers.rb 使用说明
const JSONBIN_API = "https://api.jsonbin.io/v3";
const JSONBIN_ACCESS_KEY = "$2a$10$eQrLIb.GEN3ykBi9BNq/leLOUgpAqN4aht62cmruTOJDcnD4T4Kbi";
const JSONBIN_COLLECTION_ID = "6a97e523da38895dfe2e8e1e";

const subForm = document.getElementById("subscribe-form");
const subInput = document.getElementById("subscribe-email");
const subBtn = document.getElementById("subscribe-btn");
const subMsg = document.getElementById("subscribe-msg");

subForm.addEventListener("submit", async (e) => {
  e.preventDefault();
  const email = subInput.value.trim();
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
    showSubMsg("邮箱格式不对，检查一下再试～", "error");
    return;
  }
  subBtn.disabled = true;
  subBtn.textContent = "提交中…";
  try {
    const res = await fetch(`${JSONBIN_API}/b`, {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "X-Access-Key": JSONBIN_ACCESS_KEY,
        "X-Collection-Id": JSONBIN_COLLECTION_ID,
        "X-Bin-Name": email,
      },
      body: JSON.stringify({
        email,
        subscribedAt: new Date().toISOString(),
      }),
    });
    if (res.ok) {
      showSubMsg("🎉 订阅成功，新文章发布后会邮件通知你（退订见邮件底部）", "ok");
      subInput.value = "";
    } else {
      let reason = "订阅失败，稍后再试";
      try {
        const data = await res.json();
        if (data && data.message) reason = data.message;
      } catch {}
      showSubMsg("😅 " + reason, "error");
    }
  } catch {
    showSubMsg("😅 网络异常，稍后再试", "error");
  } finally {
    subBtn.disabled = false;
    subBtn.textContent = "订阅";
  }
});

function showSubMsg(text, kind) {
  subMsg.textContent = text;
  subMsg.className = "subscribe-msg " + kind;
}
</script>
