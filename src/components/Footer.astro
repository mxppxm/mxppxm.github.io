<footer class="site-footer">
  <div class="footer-inner">
    <!-- 邮件订阅 -->
    <div class="subscribe-box" id="subscribe-box">
      <p class="subscribe-title">💌 订阅更新</p>
      <p class="subscribe-desc">留个邮箱，新文章发布后第一时间邮件通知你，随时可退订。</p>
      <form id="subscribe-form" class="subscribe-form" novalidate>
        <input
          type="email"
          id="subscribe-email"
          class="subscribe-input"
          placeholder="you@example.com"
          required
          autocomplete="email"
        />
        <button type="submit" class="subscribe-btn" id="subscribe-btn">订阅</button>
      </form>
      <p class="subscribe-msg" id="subscribe-msg"></p>
    </div>

    <p>☀️ 九日 · 用创意和代码探索世界</p>
    <p class="footer-meta">Built with Astro · 2026</p>
  </div>
</footer>

<script>
  // JSONBin 后端：access key 仅授予「创建订阅」权限（不可读取列表），见 notify_subscribers.rb 使用说明
  const JSONBIN_API = "https://api.jsonbin.io/v3";
  const JSONBIN_ACCESS_KEY = "$2a$10$eQrLIb.GEN3ykBi9BNq/leLOUgpAqN4aht62cmruTOJDcnD4T4Kbi";
  const JSONBIN_COLLECTION_ID = "6a97e523da38895dfe2e8e1e";

  const form = document.getElementById("subscribe-form");
  const input = document.getElementById("subscribe-email");
  const btn = document.getElementById("subscribe-btn");
  const msg = document.getElementById("subscribe-msg");

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const email = input.value.trim();
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      showMsg("邮箱格式不对，检查一下再试～", "error");
      return;
    }
    btn.disabled = true;
    btn.textContent = "提交中…";
    try {
      const res = await fetch(`${JSONBIN_API}/b`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "X-Access-Key": JSONBIN_ACCESS_KEY,
          "X-Collection-Id": JSONBIN_COLLECTION_ID,
          "X-Bin-Name": email,
        },
        body: JSON.stringify({
          email,
          subscribedAt: new Date().toISOString(),
        }),
      });
      if (res.ok) {
        showMsg("🎉 订阅成功，新文章发布后会邮件通知你（退订见邮件底部）", "ok");
        input.value = "";
      } else {
        let reason = "订阅失败，稍后再试";
        try {
          const data = await res.json();
          if (data && data.message) reason = data.message;
        } catch {}
        showMsg("😅 " + reason, "error");
      }
    } catch {
      showMsg("😅 网络异常，稍后再试", "error");
    } finally {
      btn.disabled = false;
      btn.textContent = "订阅";
    }
  });

  function showMsg(text, kind) {
    msg.textContent = text;
    msg.className = "subscribe-msg " + kind;
  }
</script>

