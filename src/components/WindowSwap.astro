---
export interface Props {}
---
<div class="windowswap-hero" id="ws-hero">
  <div class="ws-video-wrapper">
    <iframe
      id="ws-player"
      src="about:blank"
      allow="autoplay; fullscreen"
      allowfullscreen
      class="ws-iframe"
    ></iframe>
  </div>

  <div class="ws-fallback-bg"></div>

  <slot />

  <div class="ws-immersive-hint" id="ws-immersive-hint">
    <svg id="ws-hint-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M8 3H5a2 2 0 00-2 2v3m18 0V5a2 2 0 00-2-2h-3m0 18h3a2 2 0 002-2v-3M3 16v3a2 2 0 002 2h3"/>
    </svg>
    <span id="ws-hint-text">视频就绪后点击任意位置沉浸观看</span>
  </div>
</div>

<style is:global>
  .windowswap-hero {
    position: relative;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    margin: 0;
    -webkit-tap-highlight-color: transparent;
    -webkit-user-select: none;
    user-select: none;
  }
  .windowswap-hero.can-immersive {
    cursor: pointer;
  }

  .ws-video-wrapper {
    position: absolute;
    inset: 0;
    z-index: 1;
    opacity: 0;
    transition: opacity 0.8s ease;
  }
  /* 阶段1：视频开始播放 → 显示画面（文字保持深色，不变） */
  .windowswap-hero.video-loaded .ws-video-wrapper {
    opacity: 1;
  }

  .ws-iframe {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 177.78vh;
    height: 56.25vw;
    min-width: 100vw;
    min-height: 100vh;
    transform: translate(-50%, -50%);
    border: none;
  }

  /* 页面原色兜底 — 永远在底下，视频渐入后自然覆盖 */
  .ws-fallback-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 70% 45% at 75% 20%, rgba(7,193,96,0.06) 0%, transparent 55%),
      linear-gradient(180deg, var(--surface, #fcfaf7) 0%, var(--bg, #f7f5f0) 100%);
  }

  /* 阶段2：视频确认可见后，文字切换为白色 */
  .windowswap-hero.video-visible .hero-float .hero-text,
  .windowswap-hero.video-visible .hero-float .hero-title,
  .windowswap-hero.video-visible .hero-float .hero-sub {
    color: rgba(255,255,255,0.9);
  }
  .windowswap-hero.video-visible .hero-float .hero-title em {
    color: var(--accent, #07c160);
  }
  .windowswap-hero.video-visible .hero-float .hero-badge {
    color: #fff;
    background: rgba(255,255,255,0.1);
    border-color: rgba(255,255,255,0.16);
    backdrop-filter: blur(8px);
    transition: color 0.5s ease, background 0.5s ease, border-color 0.5s ease;
  }
  .windowswap-hero.video-visible .hero-float .hero-badge-dot {
    background: var(--accent, #07c160);
  }
  .windowswap-hero.video-visible .hero-float .hero-sub {
    text-shadow: 0 1px 4px rgba(0,0,0,0.5);
  }
  .windowswap-hero.video-visible .hero-float .hero-glyph {
    color: rgba(255,255,255,0.04);
    transition: color 0.5s ease;
  }

  /* 按钮反色 — 阶段2 */
  .windowswap-hero.video-visible .hero-float .ws-btn {
    background: rgba(255,255,255,0.08);
    color: #fff;
    border-color: rgba(255,255,255,0.22);
    backdrop-filter: blur(8px);
    transition: background 0.5s ease, color 0.5s ease, border-color 0.5s ease;
  }
  .windowswap-hero.video-visible .hero-float .ws-btn:hover {
    background: rgba(255,255,255,0.16);
    border-color: rgba(255,255,255,0.45);
    color: #fff;
  }

  .windowswap-hero:not(.video-visible) .hero-float .hero-glyph {
    animation: glyphBounce 2.5s ease-in-out infinite;
  }

  .windowswap-hero .hero-float .hero-glyph {
    transition: color 0.5s ease 0.6s, transform 0.5s ease-out;
  }

  @keyframes glyphBounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-16px); }
  }

  .windowswap-hero .hero-float .hero-text {
    transition: transform 0.7s ease, color 0.5s ease;
  }
  .windowswap-hero .hero-float .hero-visual {
    transition: transform 0.7s ease;
  }

  /* ====== 三级沉浸模式 ====== */

  /* 第二级：铺满屏幕 — 文字飞出 */
  .windowswap-hero.immersive .hero-text {
    transform: translateX(-120vw) !important;
    pointer-events: none !important;
  }
  .windowswap-hero.immersive .hero-visual {
    transform: translateX(120vw) !important;
  }
  .windowswap-hero.immersive .ws-immersive-hint {
    opacity: 1 !important;
    animation: wsHintPulse 2s ease-in-out infinite;
    pointer-events: none;
  }

  /* 第三级：浏览器全屏 */
  .windowswap-hero.fullscreen-mode .ws-immersive-hint {
    opacity: 0 !important;
    pointer-events: none !important;
  }
  .windowswap-hero:fullscreen {
    background: #000;
  }
  .windowswap-hero:fullscreen .ws-video-wrapper {
    /* 全屏时视频铺满整个屏幕 */
    inset: 0;
  }

  /* Hint */
  .ws-immersive-hint {
    position: absolute;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 8px;
    color: rgba(255,255,255,0.4);
    font-size: 12px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.5s ease;
  }
  .windowswap-hero.video-visible .ws-immersive-hint {
    opacity: 1;
    animation: wsHintPulse 3s ease-in-out infinite;
  }
  @keyframes wsHintPulse {
    0%, 100% { opacity: 0.35; }
    50% { opacity: 0.7; }
  }

  @media (max-width: 768px) {
    .hero-float {
      padding: 70px 20px 40px;
      align-items: flex-end;
      grid-template-columns: 1fr;
      gap: 0;
    }
    .hero-float .hero-visual { display: none; }
  }
</style>

<script src="https://player.vimeo.com/api/player.js"></script>

<script>
  const FEEDS_URL = '/data/windowswap-feeds.json';
  let feeds: Array<{ u: string; h: string }> = [];

  const hero = document.getElementById('ws-hero')!;
  const iframe = document.getElementById('ws-player') as HTMLIFrameElement;
  const header = document.querySelector('.site-header') as HTMLElement;
  const hintText = document.getElementById('ws-hint-text')!;

  // 三级状态机: 'default' | 'immersive' | 'fullscreen'
  let mode: 'default' | 'immersive' | 'fullscreen' = 'default';
  let isVideoLoaded = false;
  let isVideoVisible = false;
  let supportsFullscreen = false;

  async function loadFeeds() {
    try {
      const res = await fetch(FEEDS_URL);
      feeds = await res.json();
    } catch { feeds = []; }
  }

  function buildUrl(feed: { u: string; h: string }) {
    let url = `https://player.vimeo.com/video/${feed.u}?autoplay=1&muted=1&loop=1&background=1`;
    if (feed.h) url += `&h=${feed.h}`;
    return url;
  }

  function pickRandom() {
    if (!feeds.length) return;
    iframe.src = buildUrl(feeds[Math.floor(Math.random() * feeds.length)]);
  }

  function markVideoLoaded() {
    if (isVideoLoaded) return;
    isVideoLoaded = true;
    hero.classList.add('video-loaded');
  }

  function markVideoVisible() {
    if (isVideoVisible) return;
    isVideoVisible = true;
    hero.classList.add('video-visible', 'can-immersive');
    // 检测全屏能力
    supportsFullscreen = !!(document.fullscreenEnabled || (document as any).webkitFullscreenEnabled);
    updateHint();
  }

  // ====== 三级状态切换 ======

  function updateHint() {
    if (mode === 'default' && isVideoVisible) {
      hintText.textContent = '点击任意位置沉浸观看';
      hero.style.cursor = 'pointer';
    } else if (mode === 'immersive') {
      if (supportsFullscreen) {
        hintText.textContent = '再次点击进入全屏 | Esc 退出';
      } else {
        hintText.textContent = '点击任意位置退出 | Esc 退出';
      }
      hero.style.cursor = 'pointer';
    } else if (mode === 'fullscreen') {
      hintText.textContent = '';
      hero.style.cursor = 'default';
    } else {
      hero.style.cursor = '';
    }
  }

  // 第二级：铺满屏幕
  function enterImmersive() {
    if (!isVideoVisible) return;
    mode = 'immersive';
    hero.classList.add('immersive');
    header?.classList.add('header-hidden');
    iframe.style.pointerEvents = 'none';
    updateHint();
  }

  function exitImmersive() {
    if (mode !== 'immersive') return;
    mode = 'default';
    hero.classList.remove('immersive');
    header?.classList.remove('header-hidden');
    iframe.style.pointerEvents = '';
    updateHint();
  }

  // 第三级：浏览器全屏
  async function enterFullscreen() {
    if (mode !== 'immersive') return;
    mode = 'fullscreen';
    hero.classList.add('fullscreen-mode');
    updateHint();
    try {
      await hero.requestFullscreen();
    } catch {
      // 不支持全屏，退回第二级
      mode = 'immersive';
      hero.classList.remove('fullscreen-mode');
      updateHint();
    }
  }

  function exitFullscreen() {
    mode = 'immersive';
    hero.classList.remove('fullscreen-mode');
    updateHint();
  }

  // ====== 点击：逐级深入 ======
  hero.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.closest('a') || target.closest('button')) return;

    if (mode === 'default') enterImmersive();
    else if (mode === 'immersive') {
      if (supportsFullscreen) enterFullscreen();
      else exitImmersive();
    }
    // fullscreen 模式下不处理点击（用户用 Esc 退出）
  });

  // ====== Esc：逐级退出 ======
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      if (mode === 'fullscreen') {
        // 浏览器会自动退出全屏，fullscreenchange 接管
        return;
      }
      if (mode === 'immersive') {
        exitImmersive();
      }
    }
  });

  // ====== 全屏变化监听：退出全屏 → 回到铺满 ======
  document.addEventListener('fullscreenchange', () => {
    if (!document.fullscreenElement && mode === 'fullscreen') {
      exitFullscreen();
    }
  });
  // webkit 兼容
  document.addEventListener('webkitfullscreenchange', () => {
    if (!(document as any).webkitFullscreenElement && mode === 'fullscreen') {
      exitFullscreen();
    }
  });

  // ====== 滚动退出铺满模式 ======
  let lastScrollY = window.scrollY;
  window.addEventListener('scroll', () => {
    if (mode === 'immersive' && Math.abs(window.scrollY - lastScrollY) > 5) exitImmersive();
    lastScrollY = window.scrollY;
  }, { passive: true });

  // ====== 视频加载 ======
  iframe.addEventListener('load', () => {
    try {
      const player = new (window as any).Vimeo.Player(iframe);
      player.on('playing', async () => {
        markVideoLoaded();
        await new Promise(r => setTimeout(r, 600));
        try {
          const t = await player.getCurrentTime();
          if (t > 0) {
            await new Promise(r => setTimeout(r, 300));
            markVideoVisible();
            return;
          }
        } catch {}
        setTimeout(() => { if (!isVideoVisible) markVideoVisible(); }, 1200);
      });
      setTimeout(() => {
        markVideoLoaded();
        setTimeout(() => { if (!isVideoVisible) markVideoVisible(); }, 900);
      }, 5000);
    } catch {
      setTimeout(() => {
        markVideoLoaded();
        setTimeout(() => { if (!isVideoVisible) markVideoVisible(); }, 900);
      }, 4000);
    }
  });

  (async () => {
    await loadFeeds();
    pickRandom();
  })();
</script>
